#!/usr/bin/env sh
set -e

echo "🔍 Running pre-commit hook..."

# Source nvm if it exists (common on Windows)
if [ -f "$HOME/.nvm/nvm.sh" ]; then
    . "$HOME/.nvm/nvm.sh"
fi

# Add common Windows Node.js paths
export PATH="$PATH:/c/Program Files/nodejs:/c/Program Files (x86)/nodejs"
export PATH="$PATH:$APPDATA/npm:$HOME/AppData/Roaming/npm"

# Git worktrees store .git as a *file* pointing to a gitdir path on the host
# (outside the worktree), and lint-staged cannot resolve that from inside a
# container. So for worktrees: list the staged files on the host, run the same
# prettier/eslint steps lint-staged uses in the container (node_modules lives in
# a named volume), then re-stage the results on the host.
if [ -f ".git" ]; then
    if command -v docker >/dev/null 2>&1 && docker info >/dev/null 2>&1; then
        echo "⚠️ Git worktree detected. Running lint-staged checks in a Docker container."
        STAGED="$(git diff --cached --name-only --diff-filter=ACMR)"
        FORMAT_FILES="$(echo "$STAGED" | grep -E '\.(js|jsx|ts|tsx|css|json|md)$' | tr '\n' ' ' || true)"
        JS_FILES="$(echo "$STAGED" | grep -E '\.(js|jsx|ts|tsx)$' | tr '\n' ' ' || true)"
        if [ -n "$FORMAT_FILES" ]; then
            MSYS_NO_PATHCONV=1 docker run --rm \
                -v "$(pwd -W 2>/dev/null || pwd):/app" \
                -v darkmoon-wt-node-modules:/app/node_modules \
                -w /app \
                -e FORMAT_FILES="$FORMAT_FILES" \
                -e JS_FILES="$JS_FILES" \
                node:22 sh -c "git config --global --add safe.directory '*' ; test -x node_modules/.bin/prettier || npm ci --ignore-scripts --no-audit --no-fund; npx prettier --write \$FORMAT_FILES && if [ -n \"\$JS_FILES\" ]; then npx eslint --config ./config/eslint.config.js --max-warnings=0 --fix \$JS_FILES; fi"
            git add -- $FORMAT_FILES
        fi
    else
        echo "⚠️ Git worktree detected and Docker is not running. Running lint-staged on host."
        npx lint-staged --no-stash --no-hide-partially-staged --config ./config/lint-staged.config.json
    fi
# Prefer Docker if available; fallback to host lint-staged.
elif command -v docker >/dev/null 2>&1 && docker compose version >/dev/null 2>&1; then
    if ! docker compose -f config/docker-compose.yml ps solo 2>/dev/null | grep -q 'running'; then
        echo "🦖 'solo' container not running. Starting container..."
        docker compose -f config/docker-compose.yml up -d solo
    fi
    echo "✓ Using docker compose lint-staged in solo container"
    docker compose -f config/docker-compose.yml exec -T solo sh -c 'cd /app && git config --global --add safe.directory /app && npx lint-staged --no-stash --no-hide-partially-staged --config ./config/lint-staged.config.json'
elif command -v docker-compose >/dev/null 2>&1; then
    if ! docker-compose -f config/docker-compose.yml ps | grep -q 'solo.*Up'; then
        echo "🦖 'solo' container not running. Starting container..."
        docker-compose -f config/docker-compose.yml up -d solo
    fi
    echo "✓ Using docker-compose lint-staged in solo container"
    docker-compose -f config/docker-compose.yml exec -T solo sh -c 'cd /app && git config --global --add safe.directory /app && npx lint-staged --no-stash --no-hide-partially-staged --config ./config/lint-staged.config.json'
else
    echo "⚠️ Docker compose not found. Running lint-staged on host."
    npx lint-staged --no-stash --no-hide-partially-staged --config ./config/lint-staged.config.json
fi

echo "✅ Pre-commit checks passed!"